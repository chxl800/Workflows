@{
    ViewBag.Title = "About";
}

<div class="content-card">
    <h2 class="layui-font-24" id="title">
        <i class="layui-icon layui-icon-about" style="color: #1E9FFF;"></i>
        @ViewBag.Title
    </h2>
    
    @if (ViewBag.Message != null)
    {
        <div class="layui-bg-blue" style="padding: 15px; border-radius: 4px; margin: 15px 0;">
            <i class="layui-icon layui-icon-about"></i>
            <span class="layui-font-16">@ViewBag.Message</span>
        </div>
    }
    
    <hr class="layui-bg-gray">
    
    <div class="layui-text" style="line-height: 1.8;">
        <p>Use this area to provide additional information.</p>
        <p>
            这是一个基于 <strong>ASP.NET MVC</strong> 和 <strong>Layui</strong> 框架开发的演示项目。
            您可以在此页面了解更多关于我们的信息。
        </p>
    </div>
    
    <!-- 选项卡组件演示 -->
    <div class="layui-tab" lay-filter="demo-tab">
        <ul class="layui-tab-title">
            <li class="layui-this">项目介绍</li>
            <li>技术栈</li>
            <li>流程测试</li>
            <li>联系方式</li>
        </ul>
        <div class="layui-tab-content">
            <div class="layui-tab-item layui-show">
                <p style="padding: 15px; line-height: 1.8;">
                    本项目是一个使用 ASP.NET MVC 构建的 Web 应用程序，前端采用 Layui 框架，
                    提供了优雅的后台管理界面风格。
                </p>
            </div>
            <div class="layui-tab-item">
                <ul class="layui-timeline">
                    <li class="layui-timeline-item">
                        <i class="layui-icon layui-timeline-axis">&#xe67a;</i>
                        <div class="layui-timeline-content layui-text">
                            <h3 class="layui-timeline-title">后端框架</h3>
                            <p>ASP.NET MVC 5.2.9</p>
                        </div>
                    </li>
                    <li class="layui-timeline-item">
                        <i class="layui-icon layui-timeline-axis">&#xe67a;</i>
                        <div class="layui-timeline-content layui-text">
                            <h3 class="layui-timeline-title">前端框架</h3>
                            <p>Layui 2.9.16</p>
                        </div>
                    </li>
                    <li class="layui-timeline-item">
                        <i class="layui-icon layui-timeline-axis">&#xe67a;</i>
                        <div class="layui-timeline-content layui-text">
                            <h3 class="layui-timeline-title">开发语言</h3>
                            <p>C#, JavaScript, HTML5, CSS3</p>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="layui-tab-item">
                <div style="padding: 20px;">
                    <blockquote class="layui-elem-quote">
                        测试 <code>FlowNewHelper.FlowApply</code> 方法发起审批流程。
                        当前模板：@ViewBag.TemplateName（@ViewBag.TemplateCode）
                    </blockquote>
                    <form class="layui-form" id="flowTestForm" style="max-width: 600px; margin-top: 20px;">
                        <div class="layui-form-item">
                            <label class="layui-form-label">模板编码</label>
                            <div class="layui-input-block">
                                <input type="text" name="templateCode" id="test-templateCode" value="@ViewBag.TemplateCode" class="layui-input" placeholder="流程模板编码" />
                            </div>
                        </div>
                        <div class="layui-form-item">
                            <label class="layui-form-label">业务单号</label>
                            <div class="layui-input-block">
                                <input type="text" name="bizOrderNo" id="test-bizOrderNo" value="ORD@(DateTime.Now.ToString("yyyyMMddHHmmss"))" class="layui-input" placeholder="业务单据号" />
                            </div>
                        </div>
                        <div class="layui-form-item">
                            <label class="layui-form-label">发起人账号</label>
                            <div class="layui-input-block">
                                <input type="text" name="applyUserNo" id="test-applyUserNo" value="admin" class="layui-input" placeholder="发起人账号" />
                            </div>
                        </div>
                        <div class="layui-form-item">
                            <label class="layui-form-label">发起备注</label>
                            <div class="layui-input-block">
                                <textarea name="applyRemark" id="test-applyRemark" class="layui-textarea" placeholder="发起备注" style="height: 80px;">测试发起审批流程</textarea>
                            </div>
                        </div>
                        <div class="layui-form-item">
                            <label class="layui-form-label">表单数据</label>
                            <div class="layui-input-block">
                                <textarea name="formDataJson" id="test-formDataJson" class="layui-textarea" placeholder='业务表单数据JSON，用于条件分支评估，如 {"Amount":"5000","Days":"3"}' style="height: 80px;"></textarea>
                            </div>
                        </div>
                        <div class="layui-form-item">
                            <div class="layui-input-block">
                                <button type="button" class="layui-btn" id="btn-test-flow"><i class="layui-icon layui-icon-release"></i> 发起审批</button>
                            </div>
                        </div>
                    </form>
                    <div id="flow-test-result" style="margin-top: 15px; display: none;"></div>
                </div>
            </div>
            <div class="layui-tab-item">
                <p style="padding: 15px;">
                    <i class="layui-icon layui-icon-email" style="font-size: 20px; color: #1E9FFF;"></i>
                    Email: support@example.com
                </p>
                <p style="padding: 15px;">
                    <i class="layui-icon layui-icon-phone" style="font-size: 20px; color: #16b777;"></i>
                    Phone: 425.555.0100
                </p>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        layui.use(['element', 'layer'], function () {
            var element = layui.element;
            var layer = layui.layer;
            var $ = layui.$;

            // 发起审批测试
            $('#btn-test-flow').on('click', function () {
                var data = {
                    templateCode: $('#test-templateCode').val(),
                    bizOrderNo: $('#test-bizOrderNo').val(),
                    applyUserNo: $('#test-applyUserNo').val(),
                    applyRemark: $('#test-applyRemark').val(),
                    formDataJson: $('#test-formDataJson').val()
                };
                if (!data.templateCode) { layer.msg('请填写模板编码', { icon: 2 }); return; }
                if (!data.bizOrderNo) { layer.msg('请填写业务单号', { icon: 2 }); return; }
                if (!data.applyUserNo) { layer.msg('请填写发起人账号', { icon: 2 }); return; }

                var btn = $(this);
                btn.attr('disabled', true).html('<i class="layui-icon layui-icon-loading-1 layui-anim layui-anim-rotate layui-anim-loop"></i> 发起中...');

                $.ajax({
                    url: '/Home/TestFlowApply',
                    type: 'POST',
                    data: data,
                    success: function (res) {
                        btn.attr('disabled', false).html('<i class="layui-icon layui-icon-release"></i> 发起审批');
                        var icon = res.code === 0 ? 1 : 2;
                        var html = '';
                        if (res.code === 0) {
                            html = '<div class="layui-bg-green" style="padding: 15px; border-radius: 4px;">'
                                + '<i class="layui-icon layui-icon-ok"></i> '
                                + res.msg
                                + '<br><br>实例编码：<b>' + res.instanceCode + '</b>'
                                + '<br>待办任务数：<b>' + res.taskCount + '</b>'
                                + '</div>';
                        } else {
                            html = '<div class="layui-bg-red" style="padding: 15px; border-radius: 4px;">'
                                + '<i class="layui-icon layui-icon-close"></i> '
                                + res.msg
                                + '</div>';
                        }
                        $('#flow-test-result').html(html).show();
                        layer.msg(res.msg, { icon: icon });
                    },
                    error: function () {
                        btn.attr('disabled', false).html('<i class="layui-icon layui-icon-release"></i> 发起审批');
                        layer.msg('请求失败', { icon: 2 });
                    }
                });
            });
        });
    </script>
}
