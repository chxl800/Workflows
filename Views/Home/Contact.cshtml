@{
    ViewBag.Title = "Contact";
}

<div class="content-card">
    <h2 class="layui-font-24" id="title">
        <i class="layui-icon layui-icon-console" style="color: #1E9FFF;"></i>
        @ViewBag.Title
    </h2>
    
    @if (ViewBag.Message != null)
    {
        <div class="layui-bg-blue" style="padding: 15px; border-radius: 4px; margin: 15px 0;">
            <i class="layui-icon layui-icon-about"></i>
            <span class="layui-font-16">@ViewBag.Message</span>
        </div>
    }
    
    <hr class="layui-bg-gray">
    
    <!-- 联系信息卡片 -->
    <div class="layui-row layui-col-space20">
        <div class="layui-col-md6">
            <div class="content-card" style="border-left: 4px solid #1E9FFF;">
                <h3 class="layui-font-20">
                    <i class="layui-icon layui-icon-location" style="color: #1E9FFF;"></i>
                    公司地址
                </h3>
                <address style="line-height: 2;">
                    <i class="layui-icon layui-icon-home"></i> One Microsoft Way<br />
                    <i class="layui-icon layui-icon-location"></i> Redmond, WA 98052-6399<br />
                    <i class="layui-icon layui-icon-phone"></i> P: 425.555.0100
                </address>
            </div>
        </div>
        
        <div class="layui-col-md6">
            <div class="content-card" style="border-left: 4px solid #16b777;">
                <h3 class="layui-font-20">
                    <i class="layui-icon layui-icon-service" style="color: #16b777;"></i>
                    技术支持
                </h3>
                <address style="line-height: 2;">
                    <strong>Support:</strong> 
                    <a href="mailto:Support@example.com" class="layui-link">
                        <i class="layui-icon layui-icon-email"></i> Support@example.com
                    </a>
                    <br />
                    <strong>Marketing:</strong> 
                    <a href="mailto:Marketing@example.com" class="layui-link">
                        <i class="layui-icon layui-icon-email"></i> Marketing@example.com
                    </a>
                </address>
            </div>
        </div>
    </div>
    
    <!-- 联系表单 -->
    <hr class="layui-bg-gray" style="margin: 30px 0;">
    
    <h3 class="layui-font-20" style="margin-bottom: 20px;">
        <i class="layui-icon layui-icon-form" style="color: #FFB800;"></i>
        发送消息
    </h3>
    
    <form class="layui-form" lay-filter="contact-form">
        <div class="layui-form-item">
            <label class="layui-form-label">姓名</label>
            <div class="layui-input-block">
                <input type="text" name="name" required lay-verify="required" placeholder="请输入您的姓名" autocomplete="off" class="layui-input">
            </div>
        </div>
        
        <div class="layui-form-item">
            <label class="layui-form-label">邮箱</label>
            <div class="layui-input-block">
                <input type="email" name="email" required lay-verify="email" placeholder="请输入您的邮箱" autocomplete="off" class="layui-input">
            </div>
        </div>
        
        <div class="layui-form-item">
            <label class="layui-form-label">主题</label>
            <div class="layui-input-block">
                <input type="text" name="subject" required lay-verify="required" placeholder="请输入消息主题" autocomplete="off" class="layui-input">
            </div>
        </div>
        
        <div class="layui-form-item">
            <label class="layui-form-label">内容</label>
            <div class="layui-input-block">
                <textarea name="content" required lay-verify="required" placeholder="请输入消息内容" class="layui-textarea"></textarea>
            </div>
        </div>
        
        <div class="layui-form-item">
            <div class="layui-input-block">
                <button class="layui-btn" lay-submit lay-filter="submit-contact">
                    <i class="layui-icon layui-icon-ok"></i> 立即提交
                </button>
                <button type="reset" class="layui-btn layui-btn-primary">
                    <i class="layui-icon layui-icon-refresh"></i> 重置
                </button>
            </div>
        </div>
    </form>
</div>

@section scripts {
    <script>
        layui.use(['element', 'form', 'layer'], function() {
            var form = layui.form;
            var layer = layui.layer;
            
            // 表单提交事件
            form.on('submit(submit-contact)', function(data) {
                layer.msg('消息提交成功！我们会尽快与您联系。', {
                    icon: 1,
                    time: 3000
                });
                return false;
            });
        });
    </script>
}
